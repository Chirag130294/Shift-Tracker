rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then click Publish.
// Each signed-in user can read and write only their own data under users/{their uid}.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().size() < 60;

      // One document per date that has a change (vacation, sick, swap, note ...)
      match /days/{day} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                              && request.resource.data.keys().hasOnly(['type', 'shiftId', 'hours', 'person', 'note', 'lieu'])
                              && (!('note' in request.resource.data) || request.resource.data.note.size() <= 500)
                              && (!('person' in request.resource.data) || request.resource.data.person.size() <= 100);
      }
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
